# TAG='build-v1.1.0-0_2024-07-03_f54e03'
PORT=8000
SMTP_PASSWORD='some_password'
WEB_HOST=http://localhost:8000
BACKUPS_FOLDER='~/CONFORMA_BACKUP/example'
SNAPSHOTS_FOLDER='/somewhere/on/the/host/system'
# Required. A strong, random string. If nothing supplies it, launch.mjs
# invents a different one on every launch, which stops any long-lived token
# issued by `yarn token` from verifying.
JWT_SECRET='replace_me_with_a_long_random_string'
